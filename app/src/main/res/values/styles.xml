<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark navy chrome around the pixel scene, yellow accent — same palette as the rank page. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#141C4A</item>
        <item name="android:colorPrimaryDark">#0B1030</item>
        <item name="android:colorAccent">#FFD83B</item>
        <item name="android:windowBackground">#0B1030</item>
        <item name="android:textColorPrimary">#DCE6F5</item>
        <item name="android:textColorSecondary">#8AA0C0</item>
        <item name="android:colorControlActivated">#FFD83B</item>
        <item name="android:colorControlNormal">#8AA0C0</item>
        <item name="android:colorButtonNormal">#1E2C66</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FFD83B</item>
        <item name="android:colorBackground">#141C4A</item>
        <item name="android:textColorPrimary">#DCE6F5</item>
        <item name="android:textColorSecondary">#8AA0C0</item>
        <item name="android:colorControlActivated">#FFD83B</item>
        <item name="android:colorControlNormal">#8AA0C0</item>
        <item name="android:colorButtonNormal">#1E2C66</item>
    </style>
</resources>
